
APP_NAME=MMRA Backend
APP_ENV=development
API_V1_PREFIX=/api/v1

# PostgreSQL
DATABASE_URL=postgresql+psycopg://mmra_user:change_me@localhost:5432/mmra_db
# PostgreSQL
POSTGRES_USER=mmra_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=mmra_db
DATABASE_URL=postgresql+psycopg://mmra_user:CHANGE_ME@127.0.0.1:5433/mmra_db

# Firebase
FIREBASE_PROJECT_ID=mmra-dev
FIREBASE_CREDENTIALS_PATH=./secrets/mmra-dev-service-account.json

# Security
OTP_PEPPER=REPLACE_WITH_RANDOM_SECRET
RESET_TOKEN_PEPPER=REPLACE_WITH_ANOTHER_RANDOM_SECRET

# OTP policy
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
RESET_TOKEN_TTL_SECONDS=600

# SMTP - local development can use Mailpit later
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=mmra@example.test
SMTP_STARTTLS=false
SMTP_SSL=false
