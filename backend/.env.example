
# ========================================
# MMRA BACKEND - CONFIGURATION EXAMPLE
# ========================================

APP_NAME=MMRA Backend
APP_ENV=development
API_V1_PREFIX=/api/v1

# ========================================
# 1. LOCAL POSTGRESQL
# ========================================
# For Android Studio and local development.

DATABASE_URL=postgresql+psycopg://mmra_user:CHANGE_ME@127.0.0.1:5433/mmra_db

POSTGRES_USER=mmra_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=mmra_db

# ========================================
# 2. GOOGLE CLOUD SQL
# ========================================
# Only configure these in Cloud Run.
# Leave empty when developing locally.
#
# The connection name format is:
# project-id:region:instance-name
#
# CLOUD_SQL_CONNECTION_NAME=your-project:asia-southeast1:mmra-postgres
# DB_USER=mmra_app
# DB_PASSWORD=SET_IN_SECRET_MANAGER
# DB_NAME=mmra_db

CLOUD_SQL_CONNECTION_NAME=
DB_USER=
DB_PASSWORD=
DB_NAME=

# ========================================
# 3. FIREBASE
# ========================================
# Set the real Firebase project ID locally.
# Cloud Run uses its assigned service identity.

FIREBASE_PROJECT_ID=your-firebase-project-id

# Local development only.
# Leave empty on Cloud Run to use ADC.
FIREBASE_CREDENTIALS_PATH=

# ========================================
# 4. SECURITY
# ========================================
# Generate different random values.
# Never commit actual secrets.

OTP_PEPPER=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
RESET_TOKEN_PEPPER=REPLACE_WITH_ANOTHER_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# ========================================
# 5. OTP POLICY
# ========================================

OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
RESET_TOKEN_TTL_SECONDS=600

# ========================================
# 6. SMTP
# ========================================
# Local Mailpit example.
# Production must use a real email provider.

SMTP_HOST=127.0.0.1
SMTP_PORT=1026
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=mmra@example.test
SMTP_STARTTLS=false
SMTP_SSL=false

# ========================================
# 7. MEDICINE LOOKUP
# ========================================

DLPL_API_KEY=
