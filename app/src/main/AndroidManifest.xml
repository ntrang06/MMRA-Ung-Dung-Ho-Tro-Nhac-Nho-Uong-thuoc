<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Kết nối Firebase và API FastAPI -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Camera phục vụ quét thuốc -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Thông báo trên Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Đặt báo thức chính xác cho lịch nhắc thuốc -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Khôi phục lịch nhắc sau khi khởi động máy -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Truy vấn dịch vụ Text-to-Speech -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.MMRA_MedicationManager">

        <activity
            android:name="com.example.project_lttbd.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MMRA_MedicationManager"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Dịch vụ nhận thông báo Firebase Cloud Messaging -->
        <service
            android:name=".notifications.MMRAFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Receiver nhận sự kiện báo thức nhắc uống thuốc -->
        <receiver
            android:name=".notifications.alarm.MedicationAlarmReceiver"
            android:exported="false" />

    </application>
</manifest>