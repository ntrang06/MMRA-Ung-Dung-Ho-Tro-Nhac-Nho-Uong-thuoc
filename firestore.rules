
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null
          && request.auth.uid == uid;
    }

    // Chi cho phep ghi neu chua co yeu cau xoa
    // hoac yeu cau xoa dang o trang thai pending.
    //
    // Account deletion request do Backend
    // quan ly bang Firebase Admin SDK.
    function isAccountWritable(uid) {
      let deletionPath =
        /databases/$(database)/documents/accountDeletionRequests/$(uid);

      return !exists(deletionPath)
        || (
          get(deletionPath).data.uid == uid
          && get(deletionPath).data.status == 'pending'
        );
    }

    function canWriteUserData(uid) {
      return isOwner(uid)
          && isAccountWritable(uid);
    }

    match /users/{uid} {

      // Chi chu tai khoan duoc doc ho so.
      allow read: if isOwner(uid);

      // Chan ghi khi da xac nhan xoa,
      // dang xoa, xoa loi hoac da xoa.
      allow create, update, delete:
        if canWriteUserData(uid);

      match /medicines/{medicineId} {

        // Client Android cu van duoc doc.
        allow read: if isOwner(uid);

        // Ghi thuoc bat buoc thong qua FastAPI.
        allow create, update, delete: if false;
      }

      match /devices/{deviceId} {

        allow read: if isOwner(uid);

        // Chan thay doi FCM token
        // khi tai khoan khong con writable.
        allow create, update, delete:
          if canWriteUserData(uid);
      }
    }

    // Mac dinh tu choi tat ca collection khac.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
