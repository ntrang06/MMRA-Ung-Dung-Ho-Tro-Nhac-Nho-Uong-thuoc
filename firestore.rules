
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null
          && request.auth.uid == uid;
    }

    // Khong cho ghi du lieu khi tai khoan
    // dang duoc xu ly xoa hoac da xoa.
    //
    // Account deletion request do Backend
    // quan ly bang Firebase Admin SDK.
    function isAccountWritable(uid) {
      let deletionPath = /databases/$(database)/documents/accountDeletionRequests/$(uid);

      return !exists(deletionPath)
        || !(
          get(deletionPath).data.status in [
            'processing',
            'completed'
          ]
        );
    }

    function canWriteUserData(uid) {
      return isOwner(uid)
          && isAccountWritable(uid);
    }

    match /users/{uid} {

      // Chu tai khoan duoc doc ho so.
      allow read: if isOwner(uid);

      // Chi duoc ghi khi tai khoan
      // chua bat dau xu ly xoa.
      allow create, update, delete:
        if canWriteUserData(uid);

      match /medicines/{medicineId} {

        // Giu quyen doc cho client cu.
        allow read: if isOwner(uid);

        // Ghi thuoc bat buoc qua FastAPI.
        allow create, update, delete: if false;
      }

      match /devices/{deviceId} {

        allow read: if isOwner(uid);

        // Ngan dang ky / cap nhat FCM
        // trong luc xoa tai khoan.
        allow create, update, delete:
          if canWriteUserData(uid);
      }
    }

    // Mac dinh tu choi cac collection khac.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
